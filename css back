/* =======================================
   GALLERY PAGE
======================================= */

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    padding: 2rem;
}

/* Gallery images styling */
.gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 2px 10px rgba(255, 255, 255, 0.05);
    transition: transform 0.3s;
}

/* Scale effect on hover */
.gallery img:hover {
    transform: scale(1.03);
}

/* Lightbox styling */
.lightbox {
    display: none;
    position: fixed;
    z-index: 999;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

/* Lightbox image style */
.lightbox-img {
    max-width: 90%;
    max-height: 90%;
    border-radius: 8px;
}

/* Close button on lightbox */
.lightbox .close {
    position: absolute;
    top: 20px;
    right: 30px;
    font-size: 1.2rem;
    color: white;
    cursor: pointer;
}

/* =======================================
   RESUME PAGE
======================================= */

.resume-page {
    max-width: 900px;
    margin: 2rem auto;
    padding: 2rem;
    background-color: #2a2a2a;
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    line-height: 1.6;
    font-size: 1.2rem;
}

/* Resume sections spacing */
.resume-page section {
    margin-bottom: 2rem;
}

/* Headings style in resume */
.resume-page h1,
.resume-page h2 {
    color: #9e9e9e;
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
}

/* Resume lists style */
.resume-page ul {
    padding-left: 1.2rem;
    margin: 0;
}

/* Resume list items */
.resume-page li {
    margin-bottom: 0.4rem;
    font-size: 1.2rem;
}

/* Resume download button */
.view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background-color: #9e9e9e;
    color: #121212;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: background-color 0.3s ease, color 0.3s ease;
}

.view-link:hover {
    background-color: #9e9e9e;
    color: #ffffff;
}

/* Resume table style */
.resume-table {
    list-style: none;
    padding: 0;
    margin: 0;
}

/* Resume table rows layout */
.resume-table li {
    display: grid;
    grid-template-columns: 350px 20px 280px 20px 200px;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

/* Education section uses a different grid */
.resume-table.education li {
    grid-template-columns: 300px 20px 300px 20px 180px;
}

/* Resume role styling */
.resume-table .role {
    font-weight: 600;
    color: #f5f5f5;
}

/* Resume company styling */
.resume-table .company {
    color: #cccccc;
}

/* Resume dates styling */
.resume-table .dates {
    color: #999999;
}

/* Resume dash styling */
.resume-table .dash {
    color: #666;
}

/* =======================================
   CONTACT PAGE
======================================= */

/* Contact links styling */
.content a {
    color: #00bcd4;
    text-decoration: none;
    font-weight: 500;
}

.content a:hover {
    color: #ffcc00;
    text-decoration: underline;
}

/* Contact icons container */
.contact-icons {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}

/* Contact links with icons */
.contact-icons a {
    color: #00bcd4;
    text-decoration: none;
    font-weight: 500;
    font-size: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.contact-icons a:hover {
    color: #ffcc00;
    text-decoration: underline;
}